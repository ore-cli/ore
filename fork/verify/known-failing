package(codex-app-server) & test(feedback_upload_reports_transport_failure_as_json_rpc_error)
# Snapshot of the /feedback category popup; the disabled notice renders instead.
package(codex-tui) & test(feedback_selection_popup_snapshot)

# --- (2) user BYO OTLP metrics (accepted Caveat A) --------------------------
# Both configure `[otel] metrics_exporter = { otlp-http = ... }` against a local
